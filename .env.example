# Copy to .env. Never commit .env or send keys through chat.
DEEPSEEK_API_KEY=
# Real model and DSH options are documented by apps/agent/COMPATIBILITY.md.

# Used only for local development. Public deployment requires explicit configuration.
ATOMS_DEMO_CODE=atoms-demo-2026
ATOMS_ENABLE_DEMO=true
# Optional independent local state namespace; relative to the repository root.
ATOMS_DATA_ROOT=data
# Optional credentials; pnpm dev persists generated local values under ignored data/ if omitted.
ATOMS_SERVICE_TOKEN=
PREVIEW_SECRET=

API_PORT=3001
PREVIEW_PORT=3002
AGENT_PORT=4100

# Local demo bootstrap only: positive safe integer; existing configured demo code follows this limit.
# Project history/usage and construction limits remain unchanged; public reviewer stays single-project.
ATOMS_DEMO_PROJECT_LIMIT=10
