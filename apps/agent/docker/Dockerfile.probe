ARG NODE_BASE=docker.io/library/node@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb
FROM ${NODE_BASE}
LABEL atoms.owner="atoms-v03" atoms.role="isolation-probe"
COPY probe.mjs /opt/atoms-v03/probe.mjs
USER 10001:10001
WORKDIR /job
ENTRYPOINT ["node","/opt/atoms-v03/probe.mjs"]
