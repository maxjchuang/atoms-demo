API_PORT=3001
PREVIEW_PORT=3002
API_HOST=127.0.0.1
API_DATA_DIR=../../data/api
AGENT_URL=http://127.0.0.1:4100
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-token
PREVIEW_SECRET=replace-with-a-random-preview-signing-secret
PREVIEW_ORIGIN=http://127.0.0.1:3002
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Explicit development only. Off by default and rejected in production.
API_ENABLE_DEMO_SEED=0
API_DEMO_CODE=atoms-demo-local
# Trusted delivery descriptor; authenticated discovery, never guessed.
M2_TOOLCHAIN_ID=toolchain_react_v1
# Shared total Run budget (Prepare + Worker + verification/repair/clean export).
M2_MAX_MODEL_STEPS=8
M2_MAX_INPUT_TOKENS=65536
M2_MAX_OUTPUT_TOKENS=24576
M2_MAX_ACTIVE_MS=900000

# Local demo bootstrap only: positive safe integer; existing configured demo code follows this limit.
# Project history/usage and construction limits remain unchanged; public reviewer stays single-project.
ATOMS_DEMO_PROJECT_LIMIT=10
