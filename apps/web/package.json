{
  "name": "@atoms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "dev:mock": "vite --host localhost --mode mock",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:typography": "node scripts/typography-audit.mjs after"
  },
  "dependencies": {
    "@atoms/contracts": "workspace:*",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.19.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.5.0",
    "msw": "2.7.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  },
  "msw": { "workerDirectory": ["public"] }
}
